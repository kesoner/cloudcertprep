---
/**
 * Home page (/) — prerendered Astro markup.
 *
 * Recreates the MultiCertHome visual design as static HTML: hero with primary
 * CTA, cert grid, About card, and generic FAQ. The locked citation content
 * (H1, first paragraph) is carried in the visible body for SEO/citation
 * continuity. Interactive chrome (Header, Footer, DonateButton) is mounted as
 * islands by BaseLayout.
 *
 * Satisfies: R1.2, R16.4, R16.6, R16.7, R16.8
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import CertTile from '../components/landing/CertTile.astro'
import AboutCard from '../components/landing/AboutCard.astro'
import HeroStage from '../components/landing/HeroStage.astro'
import AuthLinkNotice from '../components/AuthLinkNotice.tsx'
import { buttonClass } from '../lib/buttonStyles'
import Faq from '../components/Faq.astro'
import PostCard from '../components/PostCard.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { includeDrafts } from '../lib/posts'
import {
  CERTIFICATIONS,
  DEFAULT_CERT_ID,
  getActiveTotalQuestions,
  getCertTotalQuestions,
  getSortedCerts,
} from '../data/certifications'
import { buildHomeFirstParagraph, buildHomeMetaDescription, HOME_H1 } from '../lib/citation-content'
import { SITE_URL } from '../lib/seo-data'
import { serializeJsonLd } from '../lib/jsonld'

const totalQuestions = getActiveTotalQuestions()
const clfCount = getCertTotalQuestions('clf-c02')
const aifCount = getCertTotalQuestions('aif-c01')
const defaultCert = CERTIFICATIONS[DEFAULT_CERT_ID]
// Flagship cert (DEFAULT_CERT_ID) leads the tile row — conversion order, not
// alphabetical.
const activeCerts = getSortedCerts()
  .filter(c => c.status === 'active')
  .sort((a, b) => (a.code === DEFAULT_CERT_ID ? -1 : b.code === DEFAULT_CERT_ID ? 1 : 0))
// Coming-soon certs render as greyed cards after the active ones so they are
// discoverable (their "watch on GitHub" funnel needs an inbound link) and
// signal an active roadmap — without entering the indexable signals (they stay
// out of the ItemList JSON-LD below and out of the sitemap).
const comingSoonCerts = getSortedCerts().filter(c => c.status === 'coming-soon')

const title = '免費 AWS 證照練習與模擬測驗 · CloudCertPrep-zh'
const description = buildHomeMetaDescription(clfCount, aifCount)
const canonical = SITE_URL + '/'

// Locked citation content (R16.4-R16.8). HOME_H1 renders as the single page
// <h1>; the lede (buildHomeFirstParagraph) carries the locked phrases
// ("MIT licensed", "publicly auditable on GitHub", "spaced repetition", the
// question-count regexes) so the Build_Time_Citation_Guard passes regardless
// of the hero's visual treatment.
const homeFirstParagraph = buildHomeFirstParagraph(clfCount, aifCount)

// Latest blog posts. The home page is the highest-authority page on the site,
// so body-linking /blog (not just via the Header island) opens a crawl path and
// passes link equity into the content cluster. Mirrors the proven cert-landing
// "最新學習文章" block. Non-draft posts only (drafts also show when
// PUBLIC_PREVIEW_DRAFTS is set, for branch previews), newest first.
const latestPosts = (await getCollection('blog'))
  .filter((post: CollectionEntry<'blog'>) => includeDrafts || !post.data.draft)
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)

// ItemList JSON-LD listing both active Cert_Landing URLs
const itemListJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AWS 證照模擬測驗',
  numberOfItems: activeCerts.length,
  itemListElement: activeCerts.map((cert, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: cert.name,
    url: `${SITE_URL}/${cert.provider}/${cert.code}`,
  })),
})

// SoftwareApplication JSON-LD (audit W3). Makes the "free web app" signal
// machine-readable for Google's free-tool rich results and for LLMs deciding
// which tools to recommend. Price "0" is factual; no aggregateRating is
// emitted (we do not surface a fabricated satisfaction score — the community
// pass rate on /stats is a different metric and lives in its Dataset JSON-LD).
const softwareAppJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${SITE_URL}/#app`,
  name: 'CloudCertPrep-zh',
  description: `Free, open-source AWS certification practice platform. ${totalQuestions.toLocaleString('en-US')}+ practice questions across ${activeCerts.length} active certifications, with timed mock exams, adaptive spaced repetition, and domain mastery analytics.`,
  url: `${SITE_URL}/`,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: { '@id': `${SITE_URL}/#organization` },
})
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[itemListJsonLd, softwareAppJsonLd]} headerOverlay={true}>
  {/* Billboard hero (aws.amazon.com language, DSv4.1): vivid blue field,
      floating abstract art, inset periwinkle card carrying the locked SEO
      copy. HOME_H1 is the primary <h1> (ordered first for the citation guard); the lede carries the locked
      citation phrases verbatim. Community social-proof TrustLine stays
      hidden until the attempt sample is credible. */}
  {/* Guest billboard: shown to crawlers + logged-out via cc-auth-out (CSS-hidden
      once html.cc-authed). Carries the locked HOME_H1, and stays BEFORE the
      welcome hero so HOME_H1 remains the page's first <h1> (citation guard). */}
  {defaultCert && (
    <div id="home-guest-hero" class="cc-auth-out">
      <HeroStage
        h1={HOME_H1}
        subline={`透過 ${totalQuestions.toLocaleString('zh-TW')}+ 道練習題，循序準備 AWS 證照。每題皆附解析，免費使用，無須註冊。`}
        ctaHref={`/${defaultCert.provider}/${defaultCert.code}/practice-exam`}
        ctaLabel="免費開始練習"
        metrics={[`${totalQuestions.toLocaleString('zh-TW')}+ 道練習題`, `${activeCerts.length} 項證照`, '完全免費', '沒有廣告']}
      />
    </div>
  )}

  {/* Returning-user hero: STATIC markup (props are build-time constants), shown
      only when signed in via cc-auth-in (the BaseLayout pre-paint script toggles
      html.cc-authed BEFORE paint). Static, not a client island, so the correct
      hero paints in the FIRST frame with zero blank-gap / pop-in flash;
      HeaderInteractive's cc-authed sync self-heals a stale token. NO entrance
      animation here - a .stagger/rise would reintroduce the flash. */}
  {defaultCert && (
    <section class="cc-auth-in pt-10 md:pt-14 pb-12 md:pb-16">
      <div class="max-w-6xl mx-auto px-4 md:px-8">
        <div class="grid lg:grid-cols-[1.05fr_0.85fr] gap-10 lg:gap-12 lg:items-center">
          <div>
            {/* Default copy is the returning-user greeting (the common case).
                On a first-ever signed-in home visit the pre-paint script below
                swaps the text in place (bug 6) - no CSS display toggle, which
                collided with .kicker's own `display`. */}
            <p class="kicker" id="cc-hero-kicker">歡迎回來</p>
            <h1 class="font-display mt-3 text-3xl md:text-4xl lg:text-5xl font-bold tracking-[-0.025em] text-text-primary">
              準備好了，就開始吧。
            </h1>
            <p class="mt-4 max-w-2xl text-base md:text-lg leading-relaxed text-text-muted" id="cc-hero-subline">
              接續上次的學習進度。前往學習總覽，或直接開始練習。
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={`/${defaultCert.provider}/${defaultCert.code}`} class={buttonClass({ variant: 'brand', size: 'md' })}>
                前往 {defaultCert.shortName} 學習總覽
              </a>
              <a href="#certifications" class={buttonClass({ variant: 'secondary', size: 'md' })}>
                瀏覽證照
              </a>
            </div>
          </div>

          {/* Quick-actions card: one-tap routes into practice. On lg+ it balances
              the hero's right half; below lg it stacks under the text so mobile
              returning users keep the same fast routes. Static markup (no client
              data) so it paints in the first frame, no flash. */}
          <div>
            <div class="rounded-2xl border border-border-hairline bg-bg-card shadow-card p-6">
              <p class="kicker">接續學習</p>
              <div class="mt-4 space-y-2">
                {[
                  { href: `/${defaultCert.provider}/${defaultCert.code}/practice-exam`, label: '模擬測驗', sub: '完整計時測驗與評分' },
                  { href: `/${defaultCert.provider}/${defaultCert.code}/domain-practice`, label: '領域練習', sub: '專注單一領域，即時查看回饋' },
                  { href: '/history', label: '測驗紀錄', sub: '回顧過往測驗結果' },
                ].map((item) => (
                  <a
                    href={item.href}
                    class="group flex items-center justify-between gap-3 rounded-xl border border-border-hairline bg-bg-dark/40 px-4 py-3 transition-[background-color,border-color] duration-gentle ease-out hover:bg-bg-card-hover hover:border-text-muted/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand/40"
                  >
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-text-primary">{item.label}</span>
                      <span class="block font-mono text-[12px] text-text-muted">{item.sub}</span>
                    </span>
                    <svg class="h-4 w-4 flex-shrink-0 text-text-muted/50 transition-[transform,color] duration-gentle group-hover:translate-x-0.5 group-hover:text-text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Pre-paint (also on bfcache pageshow): drop the header overlay for signed-in
      visitors - the transparent white-text overlay assumes the dark stage behind
      it, but the welcome hero is on the page bg. The hero swap itself is pure CSS
      (cc-auth-*); only the overlay attribute needs JS. */}
  {defaultCert && (
    <script is:inline>
      (function () {
        function apply() {
          if (!(window.__ccHasSession && window.__ccHasSession())) return
          var hdr = document.getElementById('site-header')
          if (hdr) hdr.removeAttribute('data-overlay')
          // First home view for a FRESHLY-created account: greet as new, not
          // "歡迎回來" (bug 6). Read the stored session user and key the
          // "greeted" flag on the account id + its age, so a brand-new account
          // gets the welcome even on a browser where a DIFFERENT account was used
          // before (the old device-only flag failed that case), and an existing
          // account is never greeted as new. Text is swapped in place pre-paint
          // so the common returning case never flashes.
          try {
            var u = null
            for (var i = 0; i < localStorage.length; i++) {
              var key = localStorage.key(i)
              if (key && key.indexOf('sb-') === 0 && key.indexOf('-auth-token') === key.length - 11) {
                try { u = (JSON.parse(localStorage.getItem(key)) || {}).user } catch (e) {}
                break
              }
            }
            if (u && u.id && u.created_at) {
              var ageMs = Date.now() - Date.parse(u.created_at)
              var greeted = (localStorage.getItem('cc_home_greeted') || '').split(',').filter(Boolean)
              if (ageMs >= 0 && ageMs < 86400000 && greeted.indexOf(u.id) === -1) {
                greeted.push(u.id)
                localStorage.setItem('cc_home_greeted', greeted.join(','))
                var k = document.getElementById('cc-hero-kicker')
                var s = document.getElementById('cc-hero-subline')
                if (k) k.textContent = '歡迎使用 CloudCertPrep-zh'
                if (s) s.textContent = '帳戶已準備完成。前往學習總覽，或直接開始練習。'
              }
            }
          } catch (e) { /* private mode / parse error: fall back to the default greeting */ }
        }
        apply()
        window.addEventListener('pageshow', apply)
        // Email-confirmation / OAuth / magic-link sign-in lands here with NO
        // session in storage yet (Supabase exchanges the URL `?code=` token
        // AFTER load), so the first apply() above bails (no token) and the
        // first-login greeting can't be chosen. `cc-authed` is now set
        // optimistically PRE-paint on a `?code=` URL (BaseLayout), so we can NOT
        // watch for a `cc-authed`-add to learn when the token lands - that
        // transition already happened before the token. Instead HeaderInteractive
        // dispatches `cc:session-resolved` once useAuth resolves (token persisted,
        // user known); re-run apply() then. It is idempotent and reads
        // user.created_at from the now-present token, so a brand-new account gets
        // the first-login greeting and a returning one keeps "歡迎回來". The
        // header-overlay half is already covered by CSS (index.css
        // html.cc-authed header[data-overlay]); apply() also drops [data-overlay].
        window.addEventListener('cc:session-resolved', apply)
      })()
    </script>
  )}

  {/* Content sheet slides over the stage with one large rounded corner. */}
  <div class="sheet-overlap pb-16 md:pb-24 pt-12 md:pt-20">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      {/* Auth redirect safety net (P0-2 / P0-3): renders only for the rare
          just-verified or expired-link cohort, null for normal traffic, so the
          empty island adds no layout box above the content stack. */}
      <AuthLinkNotice client:only="react" />
      <div class="space-y-16 md:space-y-24">

        {/* Locked citation paragraph + value props — the full SEO lede lives
            here (not in the hero card) so the page stays scannable while the
            citation guard still finds every locked phrase verbatim. */}
        <section class="max-w-3xl border-l-2 border-brand/60 pl-6 md:pl-8" data-reveal>
          <p class="text-lead">
            {homeFirstParagraph}
          </p>
        </section>

        {/* Cert tile row - editorial card grid with art headers. id anchors
            the "瀏覽證照" CTAs on /about and /contribute (P2-12).
            scroll-mt-20 keeps the "選擇你的目標證照" heading clear of the
            sticky header when these anchors land here (bug 5). */}
        <section id="certifications" data-reveal class="scroll-mt-20">
          <p class="kicker" aria-hidden="true">證照課程</p>
          <h2 class="font-display text-[1.75rem] md:text-[2.25rem] font-semibold tracking-[-0.02em] text-text-primary mb-2">
            選擇你的目標證照
          </h2>
          <p class="text-lead mb-8">
            依照證照選擇完整模擬測驗或分領域練習，循序累積實力。
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {activeCerts.map(cert => <CertTile cert={cert} />)}
            {comingSoonCerts.map(cert => <CertTile cert={cert} />)}
          </div>
        </section>

        {/* About card */}
        <AboutCard />

        {/* Latest from the blog: body-link into the content cluster (reuses the
            cert-landing pattern). Opens a crawl path from the highest-authority
            page to /blog. */}
        {latestPosts.length > 0 && (
          <section data-reveal>
            <p class="kicker" aria-hidden="true">學習指南</p>
            <h2 class="font-display text-[1.75rem] md:text-[2.25rem] font-semibold tracking-[-0.02em] text-text-primary mb-8">最新學習文章</h2>
            <div class="grid grid-cols-1 gap-6">
              {latestPosts.map((post: CollectionEntry<'blog'>) => (
                <PostCard data={post.data} slug={post.data.slug} />
              ))}
            </div>
            <p class="mt-6">
              <a href="/blog" class="chev-link text-sm md:text-base font-medium text-link hover:underline underline-offset-4">閱讀所有文章<span class="chev" aria-hidden="true">›</span></a>
            </p>
          </section>
        )}

        {/* Generic FAQ */}
        <Faq genericOnly />
      </div>
    </div>
  </div>
</BaseLayout>
