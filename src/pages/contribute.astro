---
/**
 * Contribute (/contribute) — genuine prerendered Astro markup.
 *
 * The top of the open-source contribution funnel: explains how to add or fix
 * questions, report errors, write blog content, and contribute code. Links
 * into CONTRIBUTING.md and the good-first-issue filter on GitHub Issues.
 *
 * Satisfies: R22.1, R22.3.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import HeroMini from '../components/landing/HeroMini.astro'
import Card from '../components/Card.astro'
import Button from '../components/Button.astro'
import { GITHUB_REPO_URL, GITHUB_ISSUES_URL } from '../lib/constants'
import { CERTIFICATIONS, DEFAULT_CERT_ID } from '../data/certifications'
import { SITE_URL } from '../lib/seo-data'
import { serializeJsonLd } from '../lib/jsonld'

const canonical = `${SITE_URL}/contribute`
const contributingUrl = `${GITHUB_REPO_URL}/blob/main/CONTRIBUTING.md`
const goodFirstIssuesUrl = `${GITHUB_ISSUES_URL}?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`
const dataDirUrl = `${GITHUB_REPO_URL}/tree/main/src/data`
// Quiet practice path (P2-12) for readers who want to use the platform first.
const defaultCert = CERTIFICATIONS[DEFAULT_CERT_ID]
const practiceHref = defaultCert ? `/${defaultCert.provider}/${defaultCert.code}/practice-exam` : '/'

const breadcrumbItems = [
  { label: '首頁', to: '/' },
  { label: '參與貢獻' },
]

const sectionHeading = 'text-xl md:text-2xl font-semibold tracking-[-0.01em] text-text-primary'
const bodyText = 'text-text-muted text-base md:text-lg leading-[1.7]'
const link = 'text-text-primary hover:text-text-primary/70 underline'

// Page-specific structured data (audit W14): a HowTo describing the
// contribution workflow, plus a WebPage node tying the page to the
// Organization. Makes the contribution funnel machine-readable for search +
// LLMs ("how to contribute to open-source AWS practice questions").
const contributeJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': `${canonical}#how-to-contribute`,
  name: 'How to contribute to CloudCertPrep',
  description:
    'Ways to contribute to CloudCertPrep, the MIT-licensed open-source AWS certification practice platform: add or improve questions, report errors, write study content, or contribute code.',
  mainEntityOfPage: canonical,
  publisher: { '@id': `${SITE_URL}/#organization` },
  step: [
    {
      '@type': 'HowToStep',
      name: '新增或改善題目',
      text: '題庫以 JSON 格式存放於 src/data, one file per exam domain. Add or correct questions following the schema in CONTRIBUTING.md and open a pull request; the automated validator checks your additions before review.',
      url: `${canonical}#add-questions`,
    },
    {
      '@type': 'HowToStep',
      name: '回報錯誤',
      text: 'Found a wrong answer or a typo? Open a GitHub issue describing the question and the correction so a maintainer or contributor can fix it.',
      url: `${canonical}#report-error`,
    },
    {
      '@type': 'HowToStep',
      name: '撰寫學習內容',
      text: 'Contribute blog articles and study guides as Markdown with validated frontmatter. Posts are reviewed via pull request and published to the blog.',
      url: `${canonical}#write-content`,
    },
    {
      '@type': 'HowToStep',
      name: '貢獻程式碼',
      text: 'Pick up a good first issue, fork the repository, and open a pull request. The codebase is MIT licensed and built in the open on GitHub.',
      url: `${canonical}#contribute-code`,
    },
  ],
})
---

<BaseLayout
  title="建議與貢獻 · CloudCertPrep-zh"
  description="參與 CloudCertPrep 開源專案：新增或修正 AWS 練習題、回報錯誤、撰寫學習指南或貢獻程式碼。"
  canonical={canonical}
  jsonLd={[contributeJsonLd]}
  headerOverlay={true}
  headerNoAuthedFrost={true}
>
  <Breadcrumb items={breadcrumbItems} visuallyHidden />

  <HeroMini
    kicker="開放原始碼"
    title="請支持 Alex 的原專案"
    lede="CloudCertPrep-zh 是 kesoner 的自用 fork。題目修正、功能建議與貢獻，請直接向原作者 Alex 提出。"
    crumbs={[{ label: '首頁', href: '/' }, { label: '參與貢獻' }]}
    maxWidth="max-w-3xl"
  />

  <div class="sheet-overlap pb-16 md:pb-24 pt-10 md:pt-14">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <div class="space-y-10 max-w-[68ch] mx-auto">
        <p class={bodyText}>
          所有題目、解析與原始碼都公開於{' '}
          <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class={link}>GitHub</a>。想開始貢獻，可先挑選{' '}
          <a href={goodFirstIssuesUrl} target="_blank" rel="noopener noreferrer" class={link}>good first issue</a>.
        </p>

        <section id="add-questions" class="space-y-3">
          <h2 class={sectionHeading}>新增或改善題目</h2>
          <p class={bodyText}>
            題庫以 JSON 格式存放於{' '}
            <a href={dataDirUrl} target="_blank" rel="noopener noreferrer" class={link}>src/data</a>，每個考試領域各有一個檔案。題目依官方指南撰寫，並附詳細解析。貢獻流程、題目格式與驗證規則請見{' '}
            <a href={contributingUrl} target="_blank" rel="noopener noreferrer" class={link}>CONTRIBUTING.md</a>。提出 Pull Request 後，自動驗證工具會在審查前檢查新增內容。
          </p>
        </section>

        <section id="report-error" class="space-y-3">
          <h2 class={sectionHeading}>回報錯誤</h2>
          <p class={bodyText}>
            發現錯誤答案、過時服務名稱或不清楚的解析？請前往{' '}
            <a href={GITHUB_ISSUES_URL} target="_blank" rel="noopener noreferrer" class={link}>GitHub Issues</a>。網站範例題也附有回報連結，會自動帶入題目編號，方便提出修正。
          </p>
        </section>

        <section id="write-content" class="space-y-3">
          <h2 class={sectionHeading}>撰寫學習內容</h2>
          <p class={bodyText}>
            The{' '}
            <a href="/blog" class={link}>學習文章</a>{' '}
            涵蓋備考策略、領域深入介紹與職涯主題。若想撰寫指南，請先提出 Issue 說明主題。文章使用 Markdown 與簡單的 frontmatter 格式，不需要熟悉建置工具。
          </p>
        </section>

        <section id="contribute-code" class="space-y-3">
          <h2 class={sectionHeading}>貢獻程式碼</h2>
          <p class={bodyText}>
            平台使用 Astro 與 React。歡迎修正問題、改善無障礙體驗或貢獻功能。可先從以下項目開始：{' '}
            <a href={goodFirstIssuesUrl} target="_blank" rel="noopener noreferrer" class={link}>good first issue</a>{' '}
            或提出新 Issue 分享你的想法。請參閱{' '}
            <a href={contributingUrl} target="_blank" rel="noopener noreferrer" class={link}>CONTRIBUTING.md</a>{' '}
            了解本機開發設定。
          </p>
        </section>

        {/* Closing CTA (P2-12): keep the GitHub-first framing but offer a quiet
            path to just use the platform. */}
        <Card as="section" padding="md" class="text-center">
          <h2 class="text-xl md:text-2xl font-semibold tracking-[-0.01em] text-text-primary mb-2">想先體驗練習嗎？</h2>
          <p class="text-text-muted mb-5">不必註冊或參與貢獻，也能使用本平台。</p>
          <div class="flex flex-wrap justify-center gap-3">
            <Button href={practiceHref} variant="brand" size="lg" arrow>
              免費開始練習
            </Button>
            <Button href="/#certifications" variant="secondary" size="lg">
              瀏覽證照
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>
