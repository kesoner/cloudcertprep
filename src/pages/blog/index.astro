---
/**
 * Blog index (/blog) — post listing.
 *
 * Lists non-draft posts (in PROD), sorted by date descending. Because the
 * route is a single static page (index.astro has no [page] param segment to
 * spread paginate() URLs into), the listing renders up to PAGE_SIZE most
 * recent posts; when the catalogue grows past PAGE_SIZE a dedicated
 * `blog/page/[page].astro` route can take over numbered pages. The canonical
 * is self-referential and RSS autodiscovery is emitted via BaseLayout's named
 * `head` slot.
 */
import { getCollection, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import HeroMini from '../../components/landing/HeroMini.astro'
import PostCard from '../../components/PostCard.astro'
import { SITE_URL } from '../../lib/seo-data'
import { includeDrafts } from '../../lib/posts'

// G5 content-scale pre-flight: pagination is consciously deferred until the
// catalogue actually passes this trigger (see the file docblock above for
// where `blog/page/[page].astro` would go). Do not build it early.
const PAGE_SIZE = 10

const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) =>
  includeDrafts || data.draft !== true,
)
const sorted = posts
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, PAGE_SIZE)

const canonical = `${SITE_URL}/blog`

const breadcrumbItems = [{ label: '首頁', to: '/' }, { label: '學習文章' }]

const description =
  '閱讀 Cloud Practitioner 與 AI Practitioner 的學習指南、測驗形式與準備策略。文章保留英文原文，方便對照官方術語。'
---

<BaseLayout title="AWS Certification Study Guides · CloudCertPrep-zh 學習文章" description={description} canonical={canonical} ogImage={`${SITE_URL}/og/og-blog.png`} headerOverlay={true} headerNoAuthedFrost={true}>
  <Breadcrumb items={breadcrumbItems} visuallyHidden />

  <HeroMini
    kicker="學習指南"
    title="CloudCertPrep-zh 學習文章"
    lede={description}
    crumbs={[{ label: '首頁', href: '/' }, { label: '學習文章' }]}
    maxWidth="max-w-3xl"
  />

  <div class="sheet-overlap pb-16 md:pb-24 pt-10 md:pt-14">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      {sorted.length === 0 ? (
        <p class="text-text-muted">目前尚無文章，歡迎稍後再來。</p>
      ) : (
        <div class="space-y-5">
          {sorted.map((post: CollectionEntry<'blog'>) => (
            <PostCard data={post.data} slug={post.data.slug} />
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
