---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import HeroMini from '../components/landing/HeroMini.astro'
import Card from '../components/Card.astro'
import Button from '../components/Button.astro'
import { GITHUB_REPO_URL, KOFI_URL } from '../lib/constants'
import { CERTIFICATIONS, DEFAULT_CERT_ID } from '../data/certifications'
import { SITE_URL } from '../lib/seo-data'
import { serializeJsonLd } from '../lib/jsonld'

const canonical = SITE_URL + '/about'
const defaultCert = CERTIFICATIONS[DEFAULT_CERT_ID]
const practiceHref = '/' + defaultCert.provider + '/' + defaultCert.code + '/practice-exam'
const breadcrumbItems = [{ label: '首頁', to: '/' }, { label: '關於我們' }]
const sectionHeading = 'text-xl md:text-2xl font-semibold tracking-tight text-text-primary'
const bodyText = 'text-text-muted text-base md:text-lg leading-[1.8]'
const link = 'text-text-primary underline underline-offset-2 hover:text-text-primary/70'
const aboutPageJsonLd = serializeJsonLd({
  '@context': 'https://schema.org', '@type': 'AboutPage',
  '@id': canonical + '#aboutpage', url: canonical,
  name: '關於 CloudCertPrep-zh', inLanguage: 'zh-Hant',
  description: 'kesoner 自用的繁體中文 fork，原專案 CloudCertPrep 由 Alex Santonastaso 建立與維護。',
  mainEntity: {
    '@type': 'SoftwareSourceCode', name: 'CloudCertPrep-zh',
    codeRepository: 'https://github.com/kesoner/cloudcertprep',
    isBasedOn: { '@type': 'SoftwareSourceCode', name: 'CloudCertPrep', codeRepository: GITHUB_REPO_URL, author: { '@id': SITE_URL + '/#author' } },
  },
})
---

<BaseLayout title="關於 CloudCertPrep-zh · kesoner 的自用繁中 fork"
  description="CloudCertPrep-zh 是 kesoner 為平板刷題與雲端架構實作建立的自用 fork。原作者為 Alex，建議與贊助請支持原專案；帳戶與資料不保證保存。"
  canonical={canonical} jsonLd={[aboutPageJsonLd]} headerOverlay={true} headerNoAuthedFrost={true}>
  <Breadcrumb items={breadcrumbItems} visuallyHidden />
  <HeroMini kicker="關於這個 fork" title="關於 CloudCertPrep-zh"
    lede="英文不太好，想躺在床上用平板舒服刷題。這就是這個自用 fork 的起點。"
    crumbs={[{ label: '首頁', href: '/' }, { label: '關於我們' }]} maxWidth="max-w-3xl" />
  <div class="sheet-overlap pb-16 md:pb-24 pt-10 md:pt-14">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <div class="space-y-10 max-w-[68ch] mx-auto">
        <p class="text-lg md:text-xl leading-relaxed text-text-primary">
          我是 kesoner，並非 CloudCertPrep 原專案的開發者或維護者。CloudCertPrep-zh 是我為自己使用而建立的繁體中文 fork，也用來實際練習雲端架構的部署與託管。
        </p>
        <section class="space-y-3 border-t border-border-hairline pt-8">
          <h2 class={sectionHeading}>原專案與作者</h2>
          <p class={bodyText}>原專案 <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class={link}>CloudCertPrep</a> 由
            <a href="https://santonastaso.me" target="_blank" rel="noopener noreferrer" class={link}>Alex Santonastaso</a> 建立與維護。
            這裡沿用原專案的程式與英文題庫，並加入繁體中文介面及個人想用的功能。原始著作、作者署名與 MIT 授權均予保留；kesoner 的身分是這個自用 fork 的建立者與託管者。
          </p>
          <p class={bodyText}>原專案採用 <a href={GITHUB_REPO_URL + '/blob/main/LICENSE'} target="_blank" rel="noopener noreferrer" class={link}>MIT 授權（MIT licensed）</a>。
            可於 <a href={GITHUB_REPO_URL + '/graphs/contributors'} target="_blank" rel="noopener noreferrer" class={link}>貢獻者列表</a> 查看原作者與協作者。
          </p>
        </section>
        <section class="space-y-3 border-t border-border-hairline pt-8">
          <h2 class={sectionHeading}>為什麼不用網頁翻譯就好？</h2>
          <p class={bodyText}>小弟英文不太好，原本想在 Alex 的 main 版本使用 Google 翻譯或沉浸式翻譯輔助閱讀，卻遇到畫面更新錯誤。fork 的修正紀錄具體重現了 Google 翻譯與 React 的衝突：</p>
          <ol class="list-decimal pl-6 space-y-3 text-text-muted text-base md:text-lg leading-[1.8]">
            <li>Google 翻譯會將頁面原有的文字節點換成巢狀的 <code>&lt;font&gt;</code> 元素，改動 React 管理的 DOM。</li>
            <li>React 仍保留原文字節點的參照。「開始測驗」按鈕切換為載入文字時，可能因找不到原節點而觸發錯誤畫面。</li>
            <li>換到下一題時，也可能無法正確替換翻譯後的文字，讓上一題的題幹或選項殘留在畫面上。</li>
          </ol>
          <p class={bodyText}>具體修正與重現測試見 fork 的 <a href="https://github.com/kesoner/cloudcertprep/commit/07206518537a895ee5ede052a28eafcc2701d37f" target="_blank" rel="noopener noreferrer" class={link}>Google Translate／React 修正提交</a>。
            因此這裡直接提供繁體中文介面，題幹、選項與解析保留英文，降低依賴整頁翻譯的需要。
          </p>
        </section>
        <section class="space-y-3 border-t border-border-hairline pt-8">
          <h2 class={sectionHeading}>床上、平板與自己的小功能</h2>
          <p class={bodyText}>我想躺在床上，用平板舒服地刷題，也希望逐步朝離線使用的方向調整，於是有了這個 fork。目前不保證完整的離線使用體驗；登入及雲端紀錄仍需要網路。</p>
          <p class={bodyText}>我會不定時從 Alex 的原專案 clone／同步更新，再加上自己用得開心的功能。這不是固定更新或長期維護的承諾，主要用途就是自用，以及實際操作雲端架構。</p>
        </section>
        <section class="space-y-3 border-t border-border-hairline pt-8">
          <h2 class={sectionHeading}>建議與贊助，請直接支持 Alex</h2>
          <p class={bodyText}>對原專案、題目或功能有任何建議與改動想法，請直接向 Alex 提出：
            <a href={GITHUB_REPO_URL + '/issues'} target="_blank" rel="noopener noreferrer" class={link}>原專案 GitHub Issues</a>。
            貢獻方式可參考 <a href="/contribute" class={link}>參與貢獻</a> 與 <a href={GITHUB_REPO_URL + '/blob/main/CONTRIBUTING.md'} target="_blank" rel="noopener noreferrer" class={link}>原專案貢獻指南</a>。
          </p>
          <p class={bodyText}>如果想贊助，請把支持留給原作者：<a href={KOFI_URL} target="_blank" rel="noopener noreferrer" class={link}>贊助 Alex 的 Ko-fi</a>。本 fork 不以募款為目的。</p>
        </section>
        <section class="space-y-3 border-t border-border-hairline pt-8">
          <h2 class={sectionHeading}>資料與服務不提供保證</h2>
          <p class={bodyText}>本 fork 伺服器提供的任何資訊與儲存資料，包括帳號、作答紀錄及學習進度，均不保證正確性、完整性、可用性或永久保存。服務與資料可能隨時回退、遺失、中斷或下架，請勿視為可靠備份。</p>
          <p class={bodyText}>在適用法律允許的範圍內，kesoner 不對使用本服務、服務中斷或資料回退與遺失造成的損失負責。依法不得排除或限制的責任不受此聲明影響。</p>
          <p class={bodyText}>kesoner 保留調整、暫停、停止託管及維護本 fork 的權利。這項託管與維護決定權不改變原作者的著作權，也不限制 MIT 授權已授予的權利。詳見 <a href="/terms" class={link}>服務條款</a> 與 <a href="/privacy" class={link}>隱私權政策</a>。</p>
        </section>
        <section class="space-y-3 border-t border-border-hairline pt-8">
          <h2 class={sectionHeading}>授權疑慮與下架聯絡</h2>
          <p class={bodyText}>若本 fork 有任何違反使用條款、授權或其他權利的地方，請寫信至 <a href="mailto:kesoner666@gmail.com" class={link}>kesoner666@gmail.com</a>，我收到通知後會立即下架。</p>
        </section>
        <Card as="section" padding="md" class="text-center">
          <h2 class="text-xl font-semibold text-text-primary mb-3">想刷題，就舒服地開始吧</h2>
          <p class="text-text-muted mb-5">繁體中文介面、英文題庫。訪客也能練習。</p>
          <div class="flex flex-wrap justify-center gap-3">
            <Button href={practiceHref} variant="brand" size="lg" arrow>免費開始練習</Button>
            <Button href="/#certifications" variant="secondary" size="lg">瀏覽證照</Button>
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>
