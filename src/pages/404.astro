---
import { SITE_URL } from '../lib/seo-data'
/**
 * 404 Not Found — prerendered Astro markup. Noindexed.
 * Satisfies: R1.2
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Button from '../components/Button.astro'
---

<BaseLayout
  title="Page Not Found · CloudCertPrep-zh"
  description="The page you are looking for does not exist."
  canonical={SITE_URL + "/404"}
  robots="noindex"
>
  <div class="flex-1 flex flex-col items-center justify-center p-8 text-center">
    <h1 class="font-mono text-7xl md:text-8xl font-bold tracking-tight text-text-primary mb-4">404</h1>
    <p class="text-xl font-semibold tracking-[-0.01em] text-text-primary mb-2">找不到頁面</p>
    <p class="text-text-muted mb-8 max-w-md">你要找的頁面不存在，或已移至其他位置。</p>
    <Button href="/">返回首頁</Button>
    <a href="/#certifications" class="mt-4 text-sm text-text-muted underline underline-offset-2 hover:text-text-primary transition-colors">瀏覽證照</a>
  </div>

  <script is:inline>
    // AnalyticsBootstrap hydrates client:idle, which can land AFTER the load
    // event — poll briefly instead of racing it.
    (function(){var n=0,t=setInterval(function(){if(window.trackEvent){clearInterval(t);window.trackEvent('page_not_found',{path:location.pathname})}else if(++n>40){clearInterval(t)}},250)})();
  </script>
</BaseLayout>
