---
/**
 * AboutCard.astro — "貼近實際考試的練習體驗" feature grid (DSv5.2).
 * The single platform-pillars section on the home page: the old "Built to
 * mirror" pair and the "關於 CloudCertPrep" grid said the same things in the
 * same layout back to back, so they are merged and deduplicated here. Open
 * 2x2 grid of icon rows (one feature language page-wide), with the
 * free/open-source line + project link as the section footer.
 */
import { GITHUB_REPO_URL } from '../../lib/constants'

interface Props {
  heading?: string
}

const { heading = '貼近實際考試的練習體驗' } = Astro.props

// lucide icon path data (24x24, stroke-based)
const icons = {
  target: '<circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle>',
  bookCheck: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path><path d="m9 9.5 2 2 4-4"></path>',
  repeat: '<polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path>',
  barChart: '<line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line>',
}

const features = [
  {
    icon: icons.target,
    title: '完整模擬測驗',
    body: "依各證照考試指南設計題型、時間與通過門檻，以完整計時模擬測驗熟悉作答節奏。",
  },
  {
    icon: icons.bookCheck,
    title: '每題皆有詳細解析',
    body: '題目對照考試指南，解析說明正確答案的原因與其他選項的差異，幫助你理解觀念。',
  },
  {
    icon: icons.repeat,
    title: '適性間隔複習',
    body: '依過往作答表現安排練習，優先複習錯題與尚未練習的題目。',
  },
  {
    icon: icons.barChart,
    title: '掌握各領域學習表現',
    body: '追蹤各考試領域的表現，找出需要加強的主題，讓每次練習更有方向。',
  },
]
---

<section>
  <p class="kicker" aria-hidden="true">平台特色</p>
  <h2 class="font-display text-[1.75rem] md:text-[2.25rem] font-semibold tracking-[-0.02em] text-text-primary mb-10">{heading}</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
    {features.map((f) => (
      <div class="border-t border-border-hairline pt-5">
        {/* Icon inline-left of the title (Stripe/Linear pattern): a quiet
            monochrome prefix, one reading unit with the heading - not a boxed
            badge stacked on top. */}
        <div class="flex items-center gap-2.5">
          <svg class="h-[18px] w-[18px] shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
          <h3 class="text-lg md:text-xl font-semibold text-text-primary">{f.title}</h3>
        </div>
        <p class="mt-2 text-base md:text-lg leading-[1.7] text-text-muted">{f.body}</p>
      </div>
    ))}
  </div>
  <p class="mt-8 flex flex-wrap items-center gap-x-2 text-base text-text-muted">
    <span>採用 MIT 授權，沒有廣告與付費門檻。原始碼公開於
      <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="text-text-primary underline underline-offset-2 hover:text-text-primary/70">GitHub</a>.</span>
    <a href="/about" class="chev-link font-medium text-text-primary underline underline-offset-4 hover:text-text-primary/70">深入了解這個專案<span class="chev" aria-hidden="true">›</span></a>
  </p>
  <slot name="footer" />
</section>
